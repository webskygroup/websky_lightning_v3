    <li class="wlh-note"><i class="fa fa-circle"></i> ماژول فعال و در حال پایش است</li>
  </ul>
</li>
<style>
.wlh-nav{direction:rtl}.wlh-trigger{height:50px!important;padding:7px 13px!important;position:relative}.wlh-icon{display:inline-flex;width:36px;height:36px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:50%;padding:3px;box-shadow:0 3px 10px rgba(37,99,235,.2)}.wlh-icon svg{width:100%;height:100%}.wlh-badge{position:absolute;top:3px;right:5px;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:#ef4444;color:#fff;font-size:10px;font-weight:700;line-height:17px;text-align:center}.wlh-menu{width:340px;padding:0;border:0;border-radius:0 0 12px 12px;overflow:hidden;box-shadow:0 14px 35px rgba(15,23,42,.25);color:#1e293b}.wlh-head{display:flex!important;align-items:center;padding:16px!important;background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff}.wlh-mark{width:42px;height:42px;border-radius:12px;background:#fbbf24;color:#172554;display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-left:10px}.wlh-head strong,.wlh-head small{display:block}.wlh-head strong{font-size:15px}.wlh-head small{opacity:.72;margin-top:3px}.wlh-stats{display:block!important;padding:8px 16px!important;max-height:335px;overflow:auto}.wlh-stat{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid #eef2f7}.wlh-stat:last-child{border-bottom:0}.wlh-stat>div strong,.wlh-stat>div small{display:block}.wlh-stat>div small{direction:ltr;text-align:right;color:#64748b;margin-top:3px;font-size:11px}.wlh-ring{--angle:0deg;width:52px;height:52px;min-width:52px;border-radius:50%;margin-left:12px;background:conic-gradient(#38bdf8 var(--angle),#e2e8f0 0);display:grid;place-items:center;position:relative}.wlh-ring:before{content:'';position:absolute;inset:5px;border-radius:50%;background:#fff}.wlh-ring b{position:relative;font-size:12px}.wlh-hit{background:conic-gradient(#10b981 var(--angle),#e2e8f0 0)}.wlh-pages{background:conic-gradient(#f59e0b var(--angle),#e2e8f0 0)}.wlh-db{background:conic-gradient(#8b5cf6 var(--angle),#e2e8f0 0)}.wlh-actions{display:flex!important;gap:8px;padding:12px 16px!important;background:#f8fafc;border-top:1px solid #eef2f7}.wlh-actions .btn{flex:1}.wlh-note{display:block!important;padding:9px 16px!important;text-align:center;color:#64748b;font-size:11px}.wlh-note i{color:#10b981;font-size:8px;margin-left:5px}@media(max-width:480px){.wlh-menu{width:300px}}
</style>
<style>
.wlh-speed-stat{padding:13px 0 7px;border-top:1px solid #eef2f7}.wlh-speed-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.wlh-speed-title strong{font-size:13px}.wlh-speed-test{border:0;border-radius:6px;background:#eff6ff;color:#2563eb;padding:4px 8px;font-size:11px}.wlh-speed-values{direction:rtl;display:flex;align-items:center;gap:7px}.wlh-speed-values>div{flex:1;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:7px;text-align:center}.wlh-speed-values span{display:block;color:#64748b;font-size:10px}.wlh-speed-values b{direction:ltr;display:inline-block;font-size:18px;margin-top:2px}.wlh-speed-values small{font-size:9px;color:#94a3b8}.wlh-speed-values>i{color:#94a3b8}.wlh-speed-gain{direction:ltr;background:#dcfce7;color:#15803d;border-radius:12px;padding:4px 6px;font-size:10px;font-style:normal;font-weight:700}.wlh-speed-note{display:block;margin-top:7px;color:#94a3b8;font-size:10px}.wlh-menu{width:360px}.wlh-stats{max-height:440px}@media(max-width:480px){.wlh-menu{width:310px}}
</style>
<script>
function webskyLightningToken() { var match = window.location.href.match(/[?&]user_token=([^&#]+)/); return match ? decodeURIComponent(match[1]) : ''; }
function webskyLightningUrl(method) { return 'index.php?route=extension/module/websky_lightning/' + method + '&user_token=' + encodeURIComponent(webskyLightningToken()); }
var webskyLightningRefreshTimer = null;
var webskyLightningRefreshRequest = null;
function webskyLightningPercent(value) {
  value = parseFloat(value);
  return isFinite(value) ? Math.max(0, Math.min(100, value)) : 0;
}
function webskyLightningAngle(value) { return (webskyLightningPercent(value) * 3.6) + 'deg'; }
function webskyLightningRefresh() {
  if (webskyLightningRefreshRequest) return;
  webskyLightningRefreshRequest = $.ajax({
    url: webskyLightningUrl('headerStats'),
    dataType: 'json',
    cache: false
  }).done(function(json) {
    if (!json || !json.success) return;
    $('.wlh-badge').text(json.pages);
    $('.wlh-cpu').css('--angle', webskyLightningAngle(json.cpu)).find('b').text(json.cpu + '%');
    $('.wlh-cpu-detail').text('Load ' + json.load + ' / ' + json.cores + ' Core');
    $('.wlh-hit').css('--angle', webskyLightningAngle(json.hit_rate)).find('b').text(json.hit_rate + '%');
    $('.wlh-hit-detail').text(json.hits + ' HIT · ' + json.misses + ' MISS');
    $('.wlh-pages').css('--angle', webskyLightningAngle(json.pages)).find('b').text(json.pages);
    $('.wlh-pages-detail').text(json.size);
    $('.wlh-db').css('--angle', webskyLightningAngle(json.db_rate)).find('b').text(json.db_rate + '%');
    $('.wlh-db-detail').text(json.db_hits + ' HIT · ' + json.db_misses + ' MISS · ' + json.db_files + ' Query');
    $('.wl-gauge.cpu').css('--angle', webskyLightningAngle(json.cpu)).find('strong').text(json.cpu + '%');
    $('.wl-gauge.cpu').closest('.wl-gauge-card').find('p').text('Load ' + json.load + ' / ' + json.cores + ' Core');
    $('.wl-gauge.hit').css('--angle', webskyLightningAngle(json.hit_rate)).find('strong').text(json.hit_rate + '%');
    $('.wl-gauge.hit').closest('.wl-gauge-card').find('p').text('HIT: ' + json.hits + ' · MISS: ' + json.misses);
    $('.wl-gauge.pages').css('--angle', webskyLightningAngle(json.pages)).find('strong').text(json.pages);
    $('.wl-gauge.pages').closest('.wl-gauge-card').find('p').text(json.size);
    webskyLightningShowSpeed(json.speed_before, json.speed_after, json.speed_improvement);
  }).always(function() {
    webskyLightningRefreshRequest = null;
  });
}
function webskyLightningShowSpeed(before, after, improvement) {
  $('.wlh-speed-before').text(before === null || typeof before === 'undefined' ? '—' : before);
  $('.wlh-speed-after').text(after === null || typeof after === 'undefined' ? '—' : after);
  $('.wlh-speed-gain').text(improvement === null || typeof improvement === 'undefined' ? '—' : improvement + '%');
}
function webskyLightningStartRefresh() {
  webskyLightningStopRefresh(true);
  webskyLightningRefresh();
  webskyLightningRefreshTimer = window.setInterval(webskyLightningRefresh, 2000);
}
function webskyLightningStopRefresh(force) {
  if (!force && $('.wl-gauge.cpu').length) return;
  if (webskyLightningRefreshTimer) {
    window.clearInterval(webskyLightningRefreshTimer);
    webskyLightningRefreshTimer = null;
  }
}
$(document).on('shown.bs.dropdown', '.wlh-nav', webskyLightningStartRefresh);
$(document).on('hidden.bs.dropdown', '.wlh-nav', function() { webskyLightningStopRefresh(false); });
$(function() { if ($('.wl-gauge.cpu').length) webskyLightningStartRefresh(); });
$(document).on('click', '.wlh-settings', function(e) { e.preventDefault(); window.location.href = 'index.php?route=extension/module/websky_lightning&user_token=' + encodeURIComponent(webskyLightningToken()); });
$(document).on('click', '.wlh-speed-test', function(e) {
  e.preventDefault(); e.stopPropagation();
  webskyLightningStopRefresh(true);
  var button = $(this); button.prop('disabled', true).find('i').addClass('fa-spin');
  $('.wlh-speed-note').text('در حال اجرای ۱۰ درخواست آزمایشی؛ لطفاً صبر کنید...');
  $.post(webskyLightningUrl('headerSpeedTest'), {}, function(json) {
    if (json && json.success) {
      webskyLightningShowSpeed(json.before, json.after, json.improvement);
      $('.wlh-speed-note').text(json.status === 200 ? 'میانگین ۵ بار آزمایش برای هر حالت' : 'پاسخ فروشگاه با خطا دریافت شد');
    } else {
      $('.wlh-speed-note').text((json && json.error) || 'اجرای آزمایش ناموفق بود');
    }
  }, 'json').fail(function() {
    $('.wlh-speed-note').text('ارتباط با فروشگاه برای آزمایش برقرار نشد');
  }).always(function() {
    button.prop('disabled', false).find('i').removeClass('fa-spin');
    if ($('.wlh-nav').hasClass('open') || $('.wl-gauge.cpu').length) webskyLightningStartRefresh();
  });
});
$(document).on('click', '.wlh-clear', function(e) {
  e.preventDefault(); e.stopPropagation();
  var button = $(this); button.prop('disabled', true).find('i').attr('class', 'fa fa-spinner fa-spin');
  $.post(webskyLightningUrl('clearCache'), {}, function(json) {
    if (json && json.success) { $('.wlh-badge').text('0'); $('.wlh-pages b').text('0'); $('.wlh-pages').next().find('small').text('0 B'); }
  }, 'json').always(function() { button.prop('disabled', false).find('i').attr('class', 'fa fa-trash-o'); });
});
</script>
