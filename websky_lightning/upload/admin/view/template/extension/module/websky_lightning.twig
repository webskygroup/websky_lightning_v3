{{ header }}{{ column_left }}
<div id="content" class="wl-wrap">
  <div class="page-header"><div class="container-fluid">
    <div class="pull-right"><button type="submit" form="form-lightning" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button> <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ button_cancel }}</a></div>
    <h1 class="wl-title"><span class="wl-logo"><svg viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="wlBolt" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#38bdf8"/><stop offset="1" stop-color="#2563eb"/></linearGradient></defs><path fill="url(#wlBolt)" d="M12 16h7l4 23h26l5-17H25l-1.4-7H12z"/><circle cx="29" cy="48" r="4" fill="#2563eb"/><circle cx="46" cy="48" r="4" fill="#2563eb"/><path d="M37 4 24 28h10l-4 22 18-29H37z" fill="#fbbf24" stroke="#fff" stroke-width="2" stroke-linejoin="round"/></svg></span> {{ heading_title }} <small>v{{ module_version }}</small></h1>
  </div></div>
  <div class="container-fluid">
    <ul class="nav nav-tabs wl-tabs"><li class="active"><a href="#tab-dashboard" data-toggle="tab"><i class="fa fa-dashboard"></i> {{ text_dashboard }}</a></li><li><a href="#tab-update" data-toggle="tab"><i class="fa fa-cloud-download"></i> {{ text_update }}{% if update_available %} <span class="badge wl-badge">1</span>{% endif %}</a></li></ul>
    <div class="tab-content"><div class="tab-pane active" id="tab-dashboard">
    <div class="wl-live-panel"><div class="wl-live-head"><div><i class="fa fa-pulse fa-circle text-success"></i> <strong>{{ text_live_overview }}</strong></div><span>{{ diagnostics.server }}</span></div><div class="row wl-gauges">
      <div class="col-md-4"><div class="wl-gauge-card"><div class="wl-gauge cpu" style="--value:{{ cpu_percent }}"><div><i class="fa fa-microchip"></i><strong>{{ cpu_percent }}%</strong></div></div><h4>{{ text_cpu_load }}</h4><p>{{ cpu_load }} / {{ cpu_cores }} Core</p></div></div>
      <div class="col-md-4"><div class="wl-gauge-card"><div class="wl-gauge hit" style="--value:{{ cache_hit_rate }}"><div><i class="fa fa-bolt"></i><strong>{{ cache_hit_rate }}%</strong></div></div><h4>{{ text_cache_hit_rate }}</h4><p>{{ text_hits }}: {{ cache_hits }} · {{ text_misses }}: {{ cache_misses }}</p></div></div>
      <div class="col-md-4"><div class="wl-gauge-card"><div class="wl-gauge pages" style="--value:{{ cache_pages_percent }}"><div><i class="fa fa-files-o"></i><strong>{{ cache_file_count }}</strong></div></div><h4>{{ text_cached_pages_graph }}</h4><p>{{ cache_size }}</p></div></div>
    </div></div>
    <div class="wl-hero"><div><strong>{{ text_report }}</strong><p>{{ text_help }}</p></div><div class="wl-actions"><button type="submit" form="form-lightning" name="benchmark_mode" value="before" class="btn btn-lightning"><i class="fa fa-flag"></i> {{ button_test_before }}</button> <button type="submit" form="form-lightning" name="benchmark_mode" value="after" class="btn btn-success"><i class="fa fa-tachometer"></i> {{ button_test_after }}</button> <button type="button" class="btn btn-default" id="clear-cache"><i class="fa fa-trash"></i> {{ button_clear_cache }}</button></div></div>

    <div class="row wl-cards">
      <div class="col-md-3 col-sm-6"><div class="wl-card blue"><i class="fa fa-files-o"></i><div><span>{{ text_cache_files }}</span><strong>{{ cache_file_count }}</strong></div></div></div>
      <div class="col-md-3 col-sm-6"><div class="wl-card purple"><i class="fa fa-hdd-o"></i><div><span>{{ text_cache_size }}</span><strong>{{ cache_size }}</strong></div></div></div>
      <div class="col-md-3 col-sm-6"><div class="wl-card green"><i class="fa fa-picture-o"></i><div><span>{{ text_webp_support }}</span><strong>{% if webp_supported %}{{ text_on }}{% else %}{{ text_off }}{% endif %}</strong></div></div></div>
      <div class="col-md-3 col-sm-6"><div class="wl-card orange"><i class="fa fa-line-chart"></i><div><span>{{ text_improvement }}</span><strong>{% if improvement is not null %}{{ improvement }}%{% else %}—{% endif %}</strong></div></div></div>
    </div>

    <div class="row">
      <div class="col-md-8"><div class="panel panel-default wl-panel"><div class="panel-heading"><i class="fa fa-bar-chart"></i> {{ text_benchmark }}</div><div class="panel-body">
        <div class="row wl-compare">
          {% for item in [{'title': text_before, 'report': baseline}, {'title': text_after, 'report': after}] %}
          <div class="col-sm-6"><div class="wl-result"><h3>{{ item.title }}</h3>{% if item.report %}<div class="wl-speed">{{ item.report.avg }} <small>ms</small></div><div class="progress"><div class="progress-bar" style="width:{% if item.report.avg < 1000 %}90{% elseif item.report.avg < 2000 %}65{% else %}40{% endif %}%"></div></div><table class="table table-condensed"><tr><td>{{ text_min }}</td><td>{{ item.report.min }} ms</td></tr><tr><td>{{ text_max }}</td><td>{{ item.report.max }} ms</td></tr><tr><td>{{ text_http }}</td><td><span class="label label-{% if item.report.status == 200 %}success{% else %}danger{% endif %}">{{ item.report.status }}</span></td></tr><tr><td>{{ text_response_size }}</td><td>{{ (item.report.bytes / 1024)|round(1) }} KB</td></tr></table>{% else %}<div class="wl-empty"><i class="fa fa-clock-o"></i><p>{{ text_no_data }}</p></div>{% endif %}</div></div>
          {% endfor %}
        </div>
      </div></div></div>
      <div class="col-md-4"><div class="panel panel-default wl-panel"><div class="panel-heading"><i class="fa fa-server"></i> {{ text_environment }}</div><div class="panel-body"><table class="table table-striped table-condensed wl-env"><tr><td>{{ text_php_version }}</td><td>{{ diagnostics.php }}</td></tr><tr><td>{{ text_memory_limit }}</td><td>{{ diagnostics.memory }}</td></tr><tr><td>{{ text_opcache }}</td><td>{{ diagnostics.opcache }}</td></tr><tr><td>{{ text_gzip }}</td><td>{{ diagnostics.gzip }}</td></tr><tr><td>{{ text_webp_support }}</td><td>{{ diagnostics.webp }}</td></tr><tr><td>{{ text_database_size }}</td><td>{{ diagnostics.db_size }}</td></tr><tr><td>{{ text_database_overhead }}</td><td>{{ diagnostics.db_overhead }}</td></tr><tr><td>{{ text_db_driver }}</td><td>{{ db_driver }}</td></tr></table></div></div></div>
    </div>

    <div class="row"><div class="col-md-4"><div class="panel panel-default wl-panel"><div class="panel-heading"><i class="fa fa-lightbulb-o"></i> {{ text_recommendations }}</div><div class="panel-body"><ul class="wl-tips">{% for item in recommendations %}<li><i class="fa fa-check-circle"></i> {{ item }}</li>{% endfor %}</ul></div></div></div>
    <div class="col-md-8"><div class="panel panel-default wl-panel"><div class="panel-heading"><i class="fa fa-sliders"></i> {{ text_edit }}</div><div class="panel-body"><form action="{{ action }}" method="post" id="form-lightning" class="form-horizontal"><div class="form-group"><label class="col-sm-4 control-label">{{ entry_status }}</label><div class="col-sm-8"><select name="module_websky_lightning_status" class="form-control"><option value="1"{% if module_websky_lightning_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_websky_lightning_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>{% for item in ['page_cache','query_cache','webp'] %}<div class="form-group"><label class="col-sm-4 control-label">{{ attribute(_context, 'entry_' ~ item) }}</label><div class="col-sm-8"><input type="hidden" name="module_websky_lightning_{{ item }}" value="0"><label class="wl-switch"><input type="checkbox" name="module_websky_lightning_{{ item }}" value="1"{% if attribute(_context, 'module_websky_lightning_' ~ item) %} checked{% endif %}><span></span></label></div></div>{% endfor %}</form></div></div></div></div>
    </div><div class="tab-pane" id="tab-update">
      <div class="wl-update-hero"><div class="wl-update-icon"><i class="fa fa-cloud-download"></i></div><div><h2>{{ text_update }}</h2><p>{% if not update_connected %}{{ text_update_unavailable }}{% elseif update_available %}{{ text_update_available }}{% else %}{{ text_up_to_date }}{% endif %}</p></div><span class="label label-{% if update_available %}warning{% elseif update_connected %}success{% else %}default{% endif %} wl-status">{% if update_available %}{{ text_update_available }}{% elseif update_connected %}{{ text_up_to_date }}{% else %}{{ text_update_unavailable }}{% endif %}</span></div>
      <div class="row wl-update-cards"><div class="col-sm-4"><div class="wl-version-card"><span>{{ text_current_version }}</span><strong>{{ module_version }}</strong></div></div><div class="col-sm-4"><div class="wl-version-card"><span>{{ text_latest_version }}</span><strong>{{ latest_version ?: module_version }}</strong></div></div><div class="col-sm-4"><div class="wl-version-card"><span>{{ text_release_date }}</span><strong>{{ release_date ?: '—' }}</strong></div></div></div>
      <div class="panel panel-default wl-panel"><div class="panel-heading"><i class="fa fa-list-alt"></i> {{ text_changelog }}</div><div class="panel-body"><div class="wl-changelog">{{ changelog ? changelog|nl2br : text_no_data }}</div><hr><a href="{{ update_check_url }}" class="btn btn-default"><i class="fa fa-refresh"></i> {{ button_check_update }}</a> <a href="{{ update_download_url }}" target="_blank" rel="noopener" class="btn btn-{% if update_available %}warning{% else %}primary{% endif %}"><i class="fa fa-download"></i> {{ button_download_update }}</a></div></div>
    </div></div>
  </div>
</div>
<style>
.wl-wrap{background:#f4f7fb;min-height:100vh}.wl-tabs{margin-bottom:20px;background:#fff;padding:8px 12px 0;border-radius:10px 10px 0 0}.wl-tabs>li>a{font-weight:700}.wl-badge{background:#ef4444}.wl-hero{background:linear-gradient(135deg,#172554,#2563eb);color:#fff;border-radius:12px;padding:22px 26px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 10px 25px rgba(37,99,235,.2)}.wl-hero strong{font-size:22px}.wl-hero p{margin:6px 0 0;opacity:.8}.btn-lightning{background:#fbbf24;color:#172554;font-weight:700}.wl-cards{margin-bottom:20px}.wl-card{height:105px;border-radius:12px;color:#fff;padding:20px;display:flex;align-items:center;box-shadow:0 8px 18px rgba(15,23,42,.12)}.wl-card>i{font-size:36px;opacity:.75;margin-left:18px}.wl-card span{display:block;opacity:.85}.wl-card strong{display:block;font-size:25px;margin-top:5px}.wl-card.blue{background:linear-gradient(135deg,#2563eb,#60a5fa)}.wl-card.purple{background:linear-gradient(135deg,#7c3aed,#a78bfa)}.wl-card.green{background:linear-gradient(135deg,#059669,#34d399)}.wl-card.orange{background:linear-gradient(135deg,#ea580c,#fb923c)}.wl-panel{border:0;border-radius:12px;box-shadow:0 5px 18px rgba(15,23,42,.08);overflow:hidden}.wl-panel>.panel-heading{background:#fff;border-bottom:1px solid #e5e7eb;font-weight:700;padding:15px}.wl-result{background:#f8fafc;border:1px solid #e5e7eb;border-radius:10px;padding:16px}.wl-result h3{font-size:15px;margin:0 0 12px;color:#64748b}.wl-speed{font-size:34px;font-weight:800;color:#172554}.wl-speed small{font-size:14px}.wl-empty{text-align:center;color:#94a3b8;padding:35px 0}.wl-empty i{font-size:34px}.wl-env td:last-child{font-weight:700;text-align:left}.wl-tips{list-style:none;padding:0;margin:0}.wl-tips li{padding:9px 0;border-bottom:1px solid #eef2f7}.wl-tips i{color:#10b981;margin-left:7px}.wl-switch input{display:none}.wl-switch span{display:inline-block;width:48px;height:25px;background:#cbd5e1;border-radius:20px;position:relative;cursor:pointer;transition:.2s}.wl-switch span:after{content:'';position:absolute;width:19px;height:19px;background:#fff;border-radius:50%;top:3px;right:3px;transition:.2s}.wl-switch input:checked+span{background:#10b981}.wl-switch input:checked+span:after{right:26px}.wl-update-hero{background:linear-gradient(135deg,#0f172a,#334155);color:#fff;border-radius:12px;padding:25px;display:flex;align-items:center;margin-bottom:20px}.wl-update-icon{width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,.12);font-size:30px;display:flex;align-items:center;justify-content:center;margin-left:18px}.wl-update-hero h2{margin:0 0 6px}.wl-update-hero p{margin:0;opacity:.8}.wl-status{margin-right:auto;white-space:normal;line-height:1.7;padding:7px 10px}.wl-update-cards{margin-bottom:20px}.wl-version-card{background:#fff;border-radius:12px;padding:22px;box-shadow:0 5px 18px rgba(15,23,42,.08)}.wl-version-card span{color:#64748b;display:block}.wl-version-card strong{font-size:25px;color:#172554;display:block;margin-top:8px}.wl-changelog{white-space:normal;line-height:1.9}.wl-loading{opacity:.55;pointer-events:none}@media(max-width:767px){.wl-hero,.wl-update-hero{display:block}.wl-actions{margin-top:15px}.wl-card,.wl-version-card{margin-bottom:12px}.wl-status{display:inline-block;margin:12px 0 0}}
.wl-title{display:flex;align-items:center;gap:10px}.wl-logo{width:48px;height:48px;display:inline-flex;background:#fff;border-radius:14px;box-shadow:0 7px 18px rgba(37,99,235,.18);padding:5px}.wl-logo svg{width:100%;height:100%}.wl-live-panel{background:linear-gradient(145deg,#0f172a,#1e3a8a);border-radius:16px;padding:22px;margin-bottom:20px;color:#fff;box-shadow:0 14px 35px rgba(30,58,138,.22)}.wl-live-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;font-size:16px}.wl-live-head span{font-size:12px;opacity:.7;direction:ltr}.wl-gauge-card{text-align:center;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:18px;min-height:235px}.wl-gauge{--value:0;width:142px;height:142px;border-radius:50%;margin:0 auto 14px;background:conic-gradient(#38bdf8 calc(var(--value)*1%),rgba(255,255,255,.13) 0);display:grid;place-items:center;position:relative}.wl-gauge:before{content:'';position:absolute;inset:12px;border-radius:50%;background:#14234b;box-shadow:inset 0 0 22px rgba(0,0,0,.22)}.wl-gauge>div{position:relative;z-index:1}.wl-gauge i{display:block;font-size:24px;color:#7dd3fc;margin-bottom:5px}.wl-gauge strong{font-size:26px}.wl-gauge.hit{background:conic-gradient(#34d399 calc(var(--value)*1%),rgba(255,255,255,.13) 0)}.wl-gauge.hit i{color:#6ee7b7}.wl-gauge.pages{background:conic-gradient(#fbbf24 calc(var(--value)*1%),rgba(255,255,255,.13) 0)}.wl-gauge.pages i{color:#fde68a}.wl-gauge-card h4{font-weight:700;margin:5px 0}.wl-gauge-card p{opacity:.72;margin:0;direction:ltr}@media(max-width:767px){.wl-gauge-card{margin-bottom:12px}.wl-live-head{display:block}.wl-live-head span{display:block;margin-top:6px}}
</style>
<script>
if (window.location.hash === '#tab-update') { $('a[href="#tab-update"]').tab('show'); }
$('#clear-cache').on('click',function(){$.post('{{ clear_url }}',{},function(json){if(json.success){location.reload();}else{alert(json.error||'Error');}},'json');});
</script>
{{ footer }}
