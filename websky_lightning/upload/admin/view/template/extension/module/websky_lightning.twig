{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-lightning" class="btn btn-primary">{{ button_save }}</button><a href="{{ cancel }}" class="btn btn-default">{{ button_cancel }}</a></div><h1>{{ heading_title }}</h1></div></div>
<div class="container-fluid"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">{{ text_edit }}</h3></div><div class="panel-body"><form action="{{ action }}" method="post" id="form-lightning" class="form-horizontal"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="websky_lightning_status" class="form-control"><option value="1"{% if websky_lightning_status %} selected{% endif %}>Enabled</option><option value="0"{% if not websky_lightning_status %} selected{% endif %}>Disabled</option></select></div></div>{% for item in ['page_cache','query_cache','webp'] %}<div class="form-group"><label class="col-sm-2 control-label">{{ attribute(_context, 'entry_' ~ item) }}</label><div class="col-sm-10"><input type="hidden" name="websky_lightning_{{ item }}" value="0"><input type="checkbox" name="websky_lightning_{{ item }}" value="1"{% if attribute(_context, 'websky_lightning_' ~ item) %} checked{% endif %}></div></div>{% endfor %}</form></div></div></div></div>
{{ footer }}
