<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-lightning" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ button_cancel }}</a></div><h1>{{ heading_title }}</h1></div></div>
