  <file path="catalog/model/tool/image.php">
    <operation error="log">
      <search><![CDATA[$image_new = str_replace(' ', '%20', $image_new);]]></search>
      <add position="before"><![CDATA[
        if ($this->config->get('module_websky_lightning_status') && $this->config->get('module_websky_lightning_webp') && !defined('WEBSKY_LIGHTNING_PAGE_CACHE_RENDER') && !empty($this->request->server['HTTP_ACCEPT']) && strpos($this->request->server['HTTP_ACCEPT'], 'image/webp') !== false && is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            $websky_file = WebskyLightning::webp(DIR_IMAGE . $image_new);
            if ($websky_file !== DIR_IMAGE . $image_new) { $image_new = substr($websky_file, strlen(DIR_IMAGE)); }
        }

        ]]></add>
    </operation>
