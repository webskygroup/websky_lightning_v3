<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Websky Lightning</name>
  <code>websky_lightning</code>
  <version>1.18.2</version>
  <author>Websky</author>
  <link>https://github.com/webskygroup</link>
  <file path="catalog/controller/startup/startup.php">
    <operation error="log">
      <search><![CDATA[// Theme]]></search>
      <add position="before"><![CDATA[
        if (is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            if (!defined('WEBSKY_LIGHTNING_QUERY_CACHE')) { define('WEBSKY_LIGHTNING_QUERY_CACHE', (bool)$this->config->get('module_websky_lightning_query_cache')); }
            WebskyLightning::serve($this->registry);
        }

        ]]></add>
    </operation>
  </file>
  <file path="catalog/controller/account/login.php">
    <operation error="skip">
      <search><![CDATA[if ($customer_info && $this->customer->login($customer_info['email'], '', true)) {]]></search>
      <add position="after"><![CDATA[
        header('Set-Cookie: websky_customer=1; Path=/; Max-Age=86400; Secure; HttpOnly; SameSite=Lax', false);
      ]]></add>
    </operation>
    <operation error="skip">
      <search><![CDATA[} else {
				$this->model_account_customer->deleteLoginAttempts($this->request->post['email']);]]></search>
      <add position="replace"><![CDATA[} else {
				header('Set-Cookie: websky_customer=1; Path=/; Max-Age=86400; Secure; HttpOnly; SameSite=Lax', false);
				$this->model_account_customer->deleteLoginAttempts($this->request->post['email']);]]></add>
    </operation>
  </file>
  <file path="catalog/controller/account/logout.php">
    <operation error="skip">
      <search><![CDATA[$this->customer->logout();]]></search>
      <add position="after"><![CDATA[
			header('Set-Cookie: websky_customer=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax', false);
      ]]></add>
    </operation>
  </file>
  <file path="system/library/cart/customer.php">
    <operation error="skip">
      <search><![CDATA[$this->session->data['customer_id'] = $customer_query->row['customer_id'];]]></search>
      <add position="after"><![CDATA[
			header('Set-Cookie: websky_customer=1; Path=/; Max-Age=86400; Secure; HttpOnly; SameSite=Lax', false);
      ]]></add>
    </operation>
  </file>
  <file path="system/library/db.php">
    <operation error="skip">
      <search><![CDATA[$result = $this->adaptor->query($sql);]]></search>
      <add position="replace"><![CDATA[
        if (is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            $result = WebskyLightning::databaseQuery($this->adaptor, $sql);
        } else {
            $result = $this->adaptor->query($sql);
        }
      ]]></add>
    </operation>
    <operation error="log">
      <search><![CDATA[return $this->adaptor->query($sql);]]></search>
      <add position="replace"><![CDATA[
        if (is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            return WebskyLightning::databaseQuery($this->adaptor, $sql);
        }
        return $this->adaptor->query($sql);
      ]]></add>
    </operation>
  </file>
  <file path="catalog/model/tool/image.php">
    <operation error="log">
      <search><![CDATA[$image_new = str_replace(' ', '%20', $image_new);]]></search>
      <add position="before"><![CDATA[
        if ($this->config->get('module_websky_lightning_status') && $this->config->get('module_websky_lightning_webp') && !defined('WEBSKY_LIGHTNING_PAGE_CACHE_RENDER') && !empty($this->request->server['HTTP_ACCEPT']) && strpos($this->request->server['HTTP_ACCEPT'], 'image/webp') !== false && is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            $websky_file = WebskyLightning::webp(DIR_IMAGE . $image_new);
            if ($websky_file !== DIR_IMAGE . $image_new) { $image_new = substr($websky_file, strlen(DIR_IMAGE)); }
        }

        ]]></add>
    </operation>
  </file>
  <file path="admin/view/template/common/header.twig">
    <operation error="log"><search><![CDATA[<ul class="nav navbar-nav navbar-right">]]></search><add position="after"><![CDATA[
        {% include 'extension/dashboard/websky_lightning_header.twig' %}
      ]]></add></operation>
  </file>
</modification>
