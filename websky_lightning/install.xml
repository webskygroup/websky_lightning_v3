<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Websky Lightning</name>
  <code>websky_lightning</code>
  <version>1.9.2</version>
  <author>Websky</author>
  <link>https://github.com/webskygroup</link>
  <file path="catalog/controller/startup/startup.php">
    <operation error="log">
      <search><![CDATA[// Theme]]></search>
      <add position="before"><![CDATA[
        if (is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            if (!defined('WEBSKY_LIGHTNING_QUERY_CACHE')) { define('WEBSKY_LIGHTNING_QUERY_CACHE', (bool)$this->config->get('module_websky_lightning_query_cache')); }
            WebskyLightning::serve($this->registry);
        }

        ]]></add>
    </operation>
  </file>
  <file path="system/library/db.php">
    <operation error="skip">
      <search><![CDATA[$result = $this->adaptor->query($sql);]]></search>
      <add position="replace"><![CDATA[
        if (is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            $result = WebskyLightning::databaseQuery($this->adaptor, $sql);
        } else {
            $result = $this->adaptor->query($sql);
        }
      ]]></add>
    </operation>
    <operation error="log">
      <search><![CDATA[return $this->adaptor->query($sql);]]></search>
      <add position="replace"><![CDATA[
        if (is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            return WebskyLightning::databaseQuery($this->adaptor, $sql);
        }
        return $this->adaptor->query($sql);
      ]]></add>
    </operation>
  </file>
  <file path="catalog/model/tool/image.php">
    <operation error="log">
      <search><![CDATA[$image_new = str_replace(' ', '%20', $image_new);]]></search>
      <add position="before"><![CDATA[
        if ($this->config->get('module_websky_lightning_status') && $this->config->get('module_websky_lightning_webp') && !empty($this->request->server['HTTP_ACCEPT']) && strpos($this->request->server['HTTP_ACCEPT'], 'image/webp') !== false && is_file(DIR_SYSTEM . 'library/websky_lightning.php')) {
            require_once(DIR_SYSTEM . 'library/websky_lightning.php');
            $websky_file = WebskyLightning::webp(DIR_IMAGE . $image_new);
            if ($websky_file !== DIR_IMAGE . $image_new) { $image_new = substr($websky_file, strlen(DIR_IMAGE)); }
        }

        ]]></add>
    </operation>
  </file>
  <file path="admin/view/template/common/header.twig">
    <operation error="log"><search><![CDATA[<ul class="nav navbar-nav navbar-right">]]></search><add position="after"><![CDATA[
        {% include 'extension/dashboard/websky_lightning_header.twig' %}
      ]]></add></operation>
  </file>
</modification>
